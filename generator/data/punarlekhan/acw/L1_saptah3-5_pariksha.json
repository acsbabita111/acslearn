{"2":[["أهلين، عندي مشكلة.","अहलेन, इंदी मुश्किला।"],["النت حقّي ما يشتغل.","अन-नेत हक़्क़ी मा यिश्तग़िल।"],["إيش أسوّي؟","ईश असव्वी?"],["لو سمحت، فهّمني مرة ثانية.","लौ समह्त, फ़ह्हिमनी मर्रा तानिया।"],["طيب، حاسوّيها.","तय्यिब, हासव्वीहा।"],["مشكور.","मश्कूर।"]],
 "3":[["أهلين، أبغى أعرف رصيدي.","अहलेन, अबग़ा अअरिफ़ रसीदी।"],["بطاقة الصرّاف حقّتي ما تشتغل.","बिताक़त अस-सर्राफ़ हक़्क़ती मा तिश्तग़िल।"],["لو سمحت، شوف حسابي.","लौ समह्त, शूफ़ हिसाबी।"],["لو سمحت، عيد الرقم.","लौ समह्त, ईद अर-रक़म।"],["مشكور على مساعدتك.","मश्कूर अला मुसाअदतक।"]],
 "4":[["أهلين، صباح الخير. معاك ___.","अहलेन, सबाह अल-ख़ेर। मआक ___।"],["أنا أتصل من بتنا.","अना अत्तसिल मिन पटना।"],["عندي مشكلة في ___ حقّي.","इंदी मुश्किला फ़ी ___ हक़्क़ी।"],["تسمعني؟","तिसमअनी?"],["لو سمحت، عيد الرقم.","लौ समह्त, ईद अर-रक़म।"],["لا، بس كدا. مشكور.","ला, बस किदा। मश्कूर।"]]}
