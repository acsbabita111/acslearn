{"2":[["أهلاً، عندي مشكلة.","अहलन, इंदी मुश्किला।"],["النت بتاعي مش شغّال.","अन-नेत बताई मिश शग़्ग़ाल।"],["أعمل إيش؟","अअमिल ईश?"],["من فضلك فهّمني تاني.","मिन फ़ज़लक फ़ह्हिमनी तानी।"],["ماشي، أنا حاعملها.","माशी, अना हाअमिलहा।"],["كتّر خيرك.","कत्तर ख़ेरक।"]],
 "3":[["أهلاً، رايد أعرف رصيدي.","अहलन, रायिद अअरफ़ रसीदी।"],["كارت البنك بتاعي مش شغّال.","कार्त अल-बंक बताई मिश शग़्ग़ाल।"],["من فضلك شوف حسابي.","मिन फ़ज़लक शूफ़ हिसाबी।"],["من فضلك عيد الرقم.","मिन फ़ज़लक ईद अर-रगम।"],["كتّر خيرك على المساعدة.","कत्तर ख़ेरक अला अल-मुसाअदा।"]],
